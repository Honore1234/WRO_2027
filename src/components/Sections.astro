---
import { team } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const mail = `mailto:${team.email}`;
---

<section class="hero" id="home">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="hero-photo-slot">
    <span>ESPACIO PARA FOTO DEL EQUIPO</span>
  </div>

  <div class="wrap hero-copy">
    <p class="tag">{t.hero.tag}</p>
    <h1>{t.hero.titleLines.map((line) => <span>{line}</span>)}</h1>
    <p class="lead">{t.hero.lead}</p>

    <div class="actions">
      <a class="btn" href="#sponsors">{t.hero.primaryCta}</a>
      <a class="btn ghost" href="#results">{t.hero.secondaryCta}</a>
    </div>
  </div>

  <dl class="hud">
    {t.hero.hud.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="destination" id="results">
  <div class="destination-copy">
    <p class="tag">{t.results.tag}</p>
    <h2>{t.results.title}</h2>
    <p>{t.hero.lead}</p>
  </div>

  {t.results.items.map((item, index) => (
    <article class={`destination-card destination-card-${index + 1}`}>
      <div class="destination-image">
        <span>{index === 1 ? 'ESPACIO PARA FOTO · SINGAPUR' : 'ESPACIO PARA FOTO'}</span>
      </div>
      <div class="destination-caption">
        <strong>{item.value}</strong>
        <span>{item.text}</span>
        <small>{item.label}</small>
      </div>
    </article>
  ))}
</section>

<section class="section member-stories" id="team">
  <div class="wrap">
    <p class="tag">{t.team.tag}</p>
    <h2>{t.team.title}</h2>
    <p class="lead">{t.team.lead}</p>

    <ul class="grid3">
      {t.team.members.map((member, index) => (
        <li>
          <div class="member-photo">
            <span>{index === 1 ? 'FOTO · SINGAPUR' : 'FOTO DEL EQUIPO'}</span>
          </div>
          <h3>{member.name}</h3>
          <p>{member.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" id="stats">
  <div class="wrap">
    <ul class="stats">
      {t.results.items.map((item) => (
        <li>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
          <em>{item.text}</em>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" id="robot">
  <div class="wrap">
    <p class="tag">{t.robot.tag}</p>
    <h2>{t.robot.title}</h2>
    <p class="lead">{t.robot.lead}</p>

    <ul class="grid4">
      {t.robot.stack.map((item) => (
        <li>
          <h3>{item.label}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" id="sponsors">
  <div class="wrap">
    <p class="tag">{t.sponsors.tag}</p>
    <h2>{t.sponsors.title}</h2>
    <p class="lead">{t.sponsors.lead}</p>

    <ul class="grid3 tiers">
      {t.sponsors.tiers.map((tier) => (
        <li>
          <h3>{tier.name}</h3>
          <p class="amount">{t.sponsors.amountLabel}: {t.sponsors.amount}</p>
          <ul class="perks">
            {tier.perks.map((perk) => <li>{perk}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <div class="actions">
      <a class="btn" href={mail}>{t.sponsors.cta}</a>
    </div>
  </div>
</section>

<section class="section" id="roadmap">
  <div class="wrap">
    <p class="tag">{t.roadmap.tag}</p>
    <h2>{t.roadmap.title}</h2>

    <ol class="steps">
      {t.roadmap.steps.map((step) => (
        <li>
          <span>{step.status}</span>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section center" id="contact">
  <div class="wrap">
    <p class="tag">{t.contact.tag}</p>
    <h2 class="display">{t.contact.title}</h2>
    <p class="lead">{t.contact.lead}</p>

    <div class="actions">
      <a class="btn" href={mail}>{team.email}</a>
      <a class="btn ghost" href={team.tiktok} target="_blank" rel="noopener">TikTok</a>
      {team.youtube && (
        <a class="btn ghost" href={team.youtube} target="_blank" rel="noopener">YouTube</a>
      )}
    </div>
  </div>
</section>
