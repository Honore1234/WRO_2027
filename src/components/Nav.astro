---
import { team } from '../config';
import { getLocale, localePath, locales, useTranslations } from '../i18n';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale).nav;
---
<header class="nav" id="nav">
  <a href="#home" class="brand" aria-label={team.name}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-word">{team.name}</span>
  </a>
  <nav>
    {t.links.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
    <a class="nav-cta" href="#sponsors">{t.cta}</a>
    <span class="lang-switch" role="group" aria-label={t.switchLabel}>
      {locales.map((l) => (
        <a href={localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>{l.toUpperCase()}</a>
      ))}
    </span>
  </nav>
</header>
<script>
  const nav = document.getElementById('nav');
  const update = () => nav?.classList.toggle('is-solid', window.scrollY > 40);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
