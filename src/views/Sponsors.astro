---
import { team } from '../config';
import { useTranslations } from '../i18n';
const all = useTranslations(Astro.currentLocale);
const t = all.sponsors;
const w = all.why;
---
<section class="page-head dark">
  <div class="wrap">
    <p class="tag">{t.tag}</p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <p class="tag">{w.tag}</p>
    <h2>{w.title}</h2>
    <ul class="grid3">
      {w.items.map((i) => <li class="reveal"><h3>{i.title}</h3><p>{i.text}</p></li>)}
    </ul>
  </div>
</section>
<section class="section soft">
  <div class="wrap">
    <ul class="grid3 tiers">
      {t.tiers.map((tier) => (
        <li class="reveal">
          <h3>{tier.name}</h3>
          <p class="amount">{t.amountLabel}: {t.amount}</p>
          <ul class="perks">{tier.perks.map((p) => <li>{p}</li>)}</ul>
        </li>
      ))}
    </ul>
    <div class="actions"><a class="btn" href={`mailto:${team.email}`}>{t.cta}</a></div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <p class="tag">{t.roadmapTag}</p>
    <h2>{t.roadmapTitle}</h2>
    <ol class="steps">{t.steps.map((s) => <li><span>{s.status}</span><p>{s.text}</p></li>)}</ol>
  </div>
</section>
